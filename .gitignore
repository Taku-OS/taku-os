# Exact app-kit runtime/download/state paths, not every possible apps/home directory.
/tooling/app-kit/downloads/
/tooling/app-kit/apps/
/tooling/app-kit/state/
/tooling/app-kit/api/state/
/tooling/app-kit/api/apps/
/tooling/app-kit/runtime/react.js
/tooling/app-kit/runtime/react-dom.js
/tooling/app-kit/runtime/esbuild
/adapters/codex-runtime/downloads/
/adapters/magpie-runtime/downloads/
/system/call-translation/downloads/
/system/inputmethod/jni/prebuilt/
