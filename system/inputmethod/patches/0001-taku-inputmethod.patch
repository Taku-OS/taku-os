diff --git a/app/src/main/java/org/fcitx/fcitx5/android/core/TakuDefaults.kt b/app/src/main/java/org/fcitx/fcitx5/android/core/TakuDefaults.kt
new file mode 100644
index 0000000..ae225b3
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/core/TakuDefaults.kt
@@ -0,0 +1,48 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Taku OS Contributors
+ */
+package org.fcitx.fcitx5.android.core
+
+import java.io.File
+
+/** Seed a Chinese-first profile once. Existing and imported profiles belong to the user. */
+internal object TakuDefaults {
+    fun ensureProfile(userDir: File) {
+        val profile = userDir.resolve("config/profile")
+        if (profile.exists()) return
+        profile.parentFile!!.mkdirs()
+        val config = userDir.resolve("config/config")
+        if (!config.exists()) config.writeText("[Behavior]\nActiveByDefault=True\n")
+        // Desktop-style prediction consumes the first virtual Backspace by default.
+        // A phone keyboard should clear predictions and delete the previous character together.
+        val pinyin = userDir.resolve("config/conf/pinyin.conf")
+        if (!pinyin.exists()) {
+            pinyin.parentFile!!.mkdirs()
+            pinyin.writeText("BackspaceBehaviorOnPrediction=\"Clear candidates & backspace\"\n")
+        }
+        val temporary = File.createTempFile("taku-profile-", ".tmp", profile.parentFile)
+        try {
+            temporary.writeText("""
+                [Groups/0]
+                Name=Default
+                Default Layout=us
+                DefaultIM=pinyin
+
+                [Groups/0/Items/0]
+                Name=keyboard-us
+                Layout=
+
+                [Groups/0/Items/1]
+                Name=pinyin
+                Layout=
+
+                [GroupOrder]
+                0=Default
+            """.trimIndent() + "\n")
+            check(profile.exists() || temporary.renameTo(profile)) { "Cannot create Taku input profile" }
+        } finally {
+            temporary.delete()
+        }
+    }
+}
