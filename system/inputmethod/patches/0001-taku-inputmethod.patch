diff --git a/app/src/test/java/org/fcitx/fcitx5/android/core/TakuDefaultsTest.kt b/app/src/test/java/org/fcitx/fcitx5/android/core/TakuDefaultsTest.kt
new file mode 100644
index 0000000..fb6396c
--- /dev/null
+++ b/app/src/test/java/org/fcitx/fcitx5/android/core/TakuDefaultsTest.kt
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+package org.fcitx.fcitx5.android.core
+
+import java.nio.file.Files
+import org.junit.Assert.*
+import org.junit.Test
+
+class TakuDefaultsTest {
+    @Test fun firstLaunchIncludesChineseAndEnglishOnAnySystemLocale() {
+        val directory = Files.createTempDirectory("taku-defaults").toFile()
+        try {
+            TakuDefaults.ensureProfile(directory)
+            val profile = directory.resolve("config/profile").readText()
+            assertTrue(profile.contains("DefaultIM=pinyin"))
+            assertTrue(directory.resolve("config/config").readText().contains("ActiveByDefault=True"))
+            assertTrue(profile.contains("Name=pinyin"))
+            assertTrue(profile.contains("Name=keyboard-us"))
+            assertTrue(directory.resolve("config/conf/pinyin.conf").readText().contains("Clear candidates & backspace"))
+        } finally { directory.deleteRecursively() }
+    }
+
+    @Test fun initialProfilePreservesExistingEngineSettings() {
+        val directory = Files.createTempDirectory("taku-engine-settings").toFile()
+        try {
+            val pinyin = directory.resolve("config/conf/pinyin.conf")
+            pinyin.parentFile!!.mkdirs()
+            val custom = "BackspaceBehaviorOnPrediction=\"Only Clear candidates\"\n"
+            pinyin.writeText(custom)
+            TakuDefaults.ensureProfile(directory)
+            assertEquals(custom, pinyin.readText())
+        } finally { directory.deleteRecursively() }
+    }
+
+    @Test fun updatesPreserveImportedOrCustomizedProfile() {
+        val directory = Files.createTempDirectory("taku-custom").toFile()
+        try {
+            val profile = directory.resolve("config/profile")
+            profile.parentFile!!.mkdirs()
+            val imported = "[Groups/0]\nDefaultIM=shuangpin\n"
+            profile.writeText(imported)
+            TakuDefaults.ensureProfile(directory)
+            assertEquals(imported, profile.readText())
+        } finally { directory.deleteRecursively() }
+    }
+}
