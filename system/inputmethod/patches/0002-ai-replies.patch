+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+package org.fcitx.fcitx5.android.input.ai
+import android.app.Activity
+import android.os.Bundle
+import android.content.Intent
+import android.widget.*
+import android.view.View
+import android.graphics.Color
+import org.json.JSONObject
+
+class AiRepliesSettingsActivity : Activity() {
+    private var reloadModels: (() -> Unit)? = null
+    private var refreshGeneration = 0
+    override fun onPause() { refreshGeneration++; super.onPause() }
+    override fun onResume() { super.onResume(); reloadModels?.invoke() }
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (android.os.Build.VERSION.SDK_INT < 31) {
+            setContentView(TextView(this).apply { text = "AI 回复建议需要 Android 12 及以上的 Taku 系统。"; setPadding(32, 64, 32, 32) })
+            return
+        }
+        val prefs = getSharedPreferences("taku-ai-replies", MODE_PRIVATE)
+        val page = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(40, 24, 40, 32) }
+        page.setOnApplyWindowInsetsListener { v, insets ->
+            val b = insets.getInsets(android.view.WindowInsets.Type.systemBars()); v.setPadding(40, b.top + 24, 40, b.bottom + 32); insets
+        }
+        fun label(value: String, size: Float = 16f) = TextView(this).apply { text = value; textSize = size; setPadding(0, 16, 0, 16) }
+        page.addView(label("AI 回复建议", 24f))
+        page.addView(label("在你打开键盘时看看当前聊天，给你几句可选回复。长按候选可看完整回复，点右侧可换一组。开始打字后，建议就会收起。"))
+        page.addView(label("仅在你允许的应用中使用。当前页面截图会发送给你选择的图片模型；密码和隐私模式除外。"))
+        page.addView(Switch(this).apply {
+            text = "开启回复建议"; isChecked = prefs.getBoolean("enabled", false)
+            setOnCheckedChangeListener { _, enabled -> prefs.edit().putBoolean("enabled", enabled).apply() }
+        })
+        page.addView(Button(this).apply {
+            text = "Taku AI 系统设置"; isAllCaps = false
+            setOnClickListener { runCatching { startActivity(Intent("org.agentos.action.AI_SETTINGS").setPackage("org.agentos.agent")) } }
+        })
+        val modelStatus = label("正在查看可用的图片模型…")
+        page.addView(modelStatus)
+        val modelBox = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }; page.addView(modelBox)
+        fun refresh() {
+            val round = ++refreshGeneration
+            Thread {
+                try {
+                    val system = AiRepliesBar.call(this, JSONObject().put("action", "settings"))
+                    val all = AiRepliesBar.call(this, JSONObject().put("action", "models")).getJSONArray("models")
+                    val models = (0 until all.length()).map { all.getJSONObject(it) }.filter { it.getBoolean("imageInput") }
+                    runOnUiThread {
+                        if (isFinishing || isDestroyed || round != refreshGeneration) return@runOnUiThread
+                        modelStatus.text = if (models.isEmpty()) "先在 Taku 模型连接中添加一个支持图片的生成模型。" else "回复建议使用的图片模型"
+                        modelBox.removeAllViews()
+                        if (models.isNotEmpty()) {
+                            val defaultName = models.firstOrNull { it.getString("id") == system.optString("sceneGroup") }?.getString("name") ?: system.optString("sceneGroup")
+                            val options = arrayOf("跟随系统 · $defaultName") + models.map { it.getString("name") }
+                            val ids = listOf("") + models.map { it.getString("id") }
+                            modelBox.addView(Spinner(this).apply {
+                                adapter = ArrayAdapter(this@AiRepliesSettingsActivity, android.R.layout.simple_spinner_dropdown_item, options)
+                                setSelection(ids.indexOf(prefs.getString("model", "")).coerceAtLeast(0))
+                                onItemSelectedListener = object : AdapterView.OnItemSelectedListener {
+                                    override fun onNothingSelected(p: AdapterView<*>?) {}
+                                    override fun onItemSelected(p: AdapterView<*>?, v: View?, pos: Int, id: Long) { prefs.edit().putString("model", ids[pos]).apply() }
+                                }
+                            })
+                        }
+                    }
+                } catch (_: Exception) { runOnUiThread { if (!isDestroyed && round == refreshGeneration) modelStatus.text = "回复服务尚未连接，先更新 Taku 系统助手。" } }
+            }.start()
+        }
+        page.addView(Button(this).apply { text = "刷新图片模型"; setOnClickListener { refresh() } })
+        page.addView(label("允许使用的应用", 18f))
+        val chosen = prefs.getStringSet("apps", emptySet()).orEmpty().toMutableSet()
+        val launches = packageManager.queryIntentActivities(Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER), 0)
+        launches.distinctBy { it.activityInfo.packageName }.sortedBy { it.loadLabel(packageManager).toString() }.forEach { app ->
+            val pkg = app.activityInfo.packageName
+            if (pkg != packageName) page.addView(CheckBox(this).apply {
+                text = app.loadLabel(packageManager); isChecked = pkg in chosen
+                setOnCheckedChangeListener { _, checked -> if (checked) chosen.add(pkg) else chosen.remove(pkg); prefs.edit().putStringSet("apps", chosen.toSet()).apply() }
+            })
+        }
+        setContentView(ScrollView(this).apply { addView(page) }); reloadModels = { refresh() }
+    }
+}
