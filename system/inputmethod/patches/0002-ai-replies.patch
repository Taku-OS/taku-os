@@ -0,0 +1,218 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+package org.fcitx.fcitx5.android.input.ai
+
+import android.content.Context
+import android.content.Intent
+import android.graphics.drawable.GradientDrawable
+import android.net.Uri
+import android.os.Build
+import android.text.TextUtils
+import android.text.InputType
+import android.view.Gravity
+import android.view.View
+import android.view.WindowInsets
+import android.view.WindowManager
+import android.view.inputmethod.EditorInfo
+import android.view.inputmethod.InputConnection
+import android.widget.*
+import androidx.lifecycle.lifecycleScope
+import kotlinx.coroutines.*
+import org.fcitx.fcitx5.android.core.CapabilityFlag
+import org.fcitx.fcitx5.android.core.CapabilityFlags
+import org.fcitx.fcitx5.android.data.theme.Theme
+import org.fcitx.fcitx5.android.input.FcitxInputMethodService
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.UUID
+
+/** Existing 40dp strip. Preview is a separate non-focusable window, never a taller keyboard. */
+class AiRepliesBar(
+    private val service: FcitxInputMethodService,
+    private val theme: Theme,
+    private val onVisibilityChanged: (Boolean) -> Unit
+) : LinearLayout(service) {
+    private val prefs = service.getSharedPreferences("taku-ai-replies", Context.MODE_PRIVATE)
+    private val content = LinearLayout(context)
+    private val action = TextView(context)
+    private var task: Job? = null
+    private var preview: PopupWindow? = null
+    private var token = ""
+    private var generation = 0
+    private var activeField = ""
+    private var activeConnection: InputConnection? = null
+    private var activeInfo: EditorInfo? = null
+    private var activeFlags: CapabilityFlags? = null
+    private var candidates: List<String> = emptyList()
+    private fun dp(n: Int) = (n * resources.displayMetrics.density).toInt()
+    init {
+        orientation = HORIZONTAL; gravity = Gravity.CENTER_VERTICAL; visibility = GONE
+        contentDescription = "Taku AI 联想输入"
+        val scroll = HorizontalScrollView(context).apply {
+            isHorizontalScrollBarEnabled = false; isFillViewport = true
+            addView(content, LayoutParams(-2, -1))
+        }
+        addView(scroll, LayoutParams(0, -1, 1f))
+        addView(View(context).apply { setBackgroundColor(theme.dividerColor) }, LayoutParams(dp(1), dp(20)))
+        action.apply { textSize = 12f; gravity = Gravity.CENTER; setTextColor(theme.candidateTextColor); setPadding(dp(3), 0, dp(3), 0) }
+        addView(action, LayoutParams(dp(54), -1))
+    }
+    private fun operation(text: String, description: String, click: (() -> Unit)?) {
+        action.text = text; action.contentDescription = description; action.isEnabled = click != null
+        action.alpha = if (click == null) .45f else 1f
+        action.setOnClickListener { click?.invoke() }
+    }
+    private fun message(text: String) {
+        content.removeAllViews()
+        content.addView(TextView(context).apply {
+            this.text = text; textSize = 14f; gravity = Gravity.CENTER_VERTICAL
+            setSingleLine(); ellipsize = TextUtils.TruncateAt.END
+            setPadding(dp(10), 0, dp(8), 0); setTextColor(theme.candidateCommentColor); contentDescription = text
+        }, LayoutParams(-2, -1))
+        visibility = VISIBLE; onVisibilityChanged(true)
+    }
+    private fun allowed(info: EditorInfo, flags: CapabilityFlags): Boolean =
+        (info.inputType and InputType.TYPE_MASK_CLASS) == InputType.TYPE_CLASS_TEXT &&
+            (info.inputType and InputType.TYPE_MASK_VARIATION) !in listOf(InputType.TYPE_TEXT_VARIATION_URI, InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS, InputType.TYPE_TEXT_VARIATION_WEB_EMAIL_ADDRESS) &&
+            prefs.getBoolean("enabled", false) && info.packageName in prefs.getStringSet("apps", emptySet()).orEmpty() &&
+            !flags.has(CapabilityFlag.Password) && !flags.has(CapabilityFlag.Sensitive) &&
+            info.imeOptions and EditorInfo.IME_FLAG_NO_PERSONALIZED_LEARNING == 0 && Build.VERSION.SDK_INT >= 31
+    fun start(info: EditorInfo, flags: CapabilityFlags, restarting: Boolean) {
+        val field = "${info.packageName}:${info.fieldId}"
+        val current = service.currentInputConnection
+        if (restarting && activeField == field && current != null && activeConnection === current) return
+        dismiss(); activeField = field; activeConnection = current; activeInfo = info; activeFlags = flags
+        if (allowed(info, flags) && current != null) request(false)
+    }
+    private fun current(session: Int, ic: InputConnection): Boolean = session == generation &&
+        service.currentInputConnection === ic && service.currentInputEditorInfo?.let { "${it.packageName}:${it.fieldId}" } == activeField
+    private fun request(fresh: Boolean) {
+        val info = activeInfo ?: return
+        val flags = activeFlags ?: return
+        val ic = activeConnection ?: return
+        if (!allowed(info, flags) || service.currentInputConnection !== ic) { dismiss(); return }
+        val previous = candidates.toList()
+        cancelRound()
+        val session = generation
+        token = UUID.randomUUID().toString(); val id = token
+        message(if (fresh && previous.isNotEmpty()) "再帮你想几句…" else "让我想想怎么接这句话…")
+        operation("⋯", "正在想回复", null)
+        task = service.lifecycleScope.launch {
+            try {
+                // Let the input window settle, while filtering accidental open/close events.
+                delay(if (fresh) 120 else 260)
+                val empty = withContext(Dispatchers.IO) {
+                    ic.getTextBeforeCursor(1, 0)?.isEmpty() == true && ic.getTextAfterCursor(1, 0)?.isEmpty() == true && ic.getSelectedText(0).isNullOrEmpty()
+                }
+                if (!current(session, ic) || !empty) { if (session == generation) dismiss(); return@launch }
+                val location = IntArray(2); getLocationOnScreen(location)
+                // IME-window insets can be zero at the bottom of the display.
+                // Measure the status bar against the full display instead.
+                val captureTop = runCatching {
+                    service.getSystemService(WindowManager::class.java).maximumWindowMetrics.windowInsets.getInsets(WindowInsets.Type.statusBars()).top
+                }.getOrDefault(0)
+                val request = JSONObject().put("action", "start").put("id", id).put("foreground", info.packageName)
+                    .put("height", location[1]).put("top", captureTop).put("model", prefs.getString("model", "")).put("fresh", fresh)
+                    .put("previous", JSONArray(if (fresh) previous else emptyList<String>()))
+                var response = withContext(Dispatchers.IO) { call(context, request) }
+                val deadline = android.os.SystemClock.elapsedRealtime() + 31000
+                while (current(session, ic) && response.getString("state") == "pending" && android.os.SystemClock.elapsedRealtime() < deadline) {
+                    delay(120)
+                    response = withContext(Dispatchers.IO) { call(context, JSONObject().put("action", "poll").put("id", id)) }
+                }
+                if (!current(session, ic)) return@launch
+                if (response.getString("state") == "completed") {
+                    val all = response.getJSONObject("result").getJSONArray("candidates")
+                    candidates = (0 until all.length()).map { all.getJSONObject(it).getString("text") }
+                    if (candidates.isEmpty()) failure("这页暂时没有合适的回复", false)
+                    else render(session, ic)
+                } else failure(response.optString("message", "这次没接上，点右边再试一次"), response.optString("code") == "auth_required")
+            } catch (e: CancellationException) { throw e }
+            catch (_: Exception) { if (current(session, ic)) failure("这次没接上，点右边再试一次", false) }
+        }
+    }
+    private fun failure(text: String, reconnect: Boolean) {
+        message(text)
+        if (reconnect) operation("连接", "重新连接 Codex 账户") { openAccount() }
+        else operation("重试", "重试回复建议") { request(true) }
+    }
+    private fun render(session: Int, ic: InputConnection) {
+        content.removeAllViews()
+        candidates.forEachIndexed { i, text ->
+            if (i > 0) content.addView(View(context).apply { setBackgroundColor(theme.dividerColor) }, LayoutParams(dp(1), dp(20)).apply { gravity = Gravity.CENTER_VERTICAL })
+            content.addView(TextView(context).apply {
+                this.text = text; textSize = 16f; setSingleLine(); ellipsize = TextUtils.TruncateAt.END
+                gravity = Gravity.CENTER_VERTICAL; setTextColor(theme.candidateTextColor)
+                setPadding(dp(12), 0, dp(12), 0); maxWidth = dp(260)
+                contentDescription = "回复建议：$text"; tooltipText = "长按查看完整回复"
+                setOnClickListener { insert(text, session, ic) }
+                setOnLongClickListener { if (current(session, ic)) showPreview(text, session, ic); true }
+            }, LayoutParams(-2, -1))
+        }
+        operation("换一组", "换一组回复建议") { request(true) }
+    }
+    private fun insert(text: String, session: Int, ic: InputConnection) {
+        if (current(session, ic)) { dismiss(); service.commitText(text) }
+    }
+    private fun showPreview(text: String, session: Int, ic: InputConnection) {
+        preview?.dismiss()
+        val location = IntArray(2); getLocationOnScreen(location)
+        val width = (resources.displayMetrics.widthPixels - dp(32)).coerceAtMost(dp(480))
+        val top = rootWindowInsets?.getInsets(WindowInsets.Type.systemBars())?.top ?: dp(24)
+        val panel = LinearLayout(context).apply {
+            orientation = VERTICAL; setPadding(dp(16), dp(12), dp(16), dp(12))
+            background = GradientDrawable().apply { setColor(theme.popupBackgroundColor); cornerRadius = dp(16).toFloat(); setStroke(dp(1), theme.dividerColor) }
+        }
+        panel.addView(TextView(context).apply { this.text = "完整回复"; textSize = 13f; setTextColor(theme.candidateCommentColor); setPadding(0, 0, 0, dp(10)) })
+        val body = TextView(context).apply {
+            this.text = text; textSize = 18f; setTextColor(theme.popupTextColor); setLineSpacing(dp(3).toFloat(), 1f)
+            contentDescription = "完整回复：$text"
+        }
+        body.measure(MeasureSpec.makeMeasureSpec(width - dp(32), MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(0, MeasureSpec.UNSPECIFIED))
+        val available = (location[1] - top - dp(120)).coerceAtLeast(dp(48))
+        panel.addView(ScrollView(context).apply { addView(body) }, LayoutParams(-1, body.measuredHeight.coerceAtMost(available)))
+        val buttons = LinearLayout(context).apply { gravity = Gravity.END; setPadding(0, dp(8), 0, 0) }
+        fun button(label: String, description: String, primary: Boolean = false, click: () -> Unit) = TextView(context).apply {
+            this.text = label; contentDescription = description; textSize = 14f; gravity = Gravity.CENTER
+            setTextColor(if (primary) theme.accentKeyTextColor else theme.popupTextColor)
+            if (primary) background = GradientDrawable().apply { setColor(theme.accentKeyBackgroundColor); cornerRadius = dp(10).toFloat() }
+            setPadding(dp(14), 0, dp(14), 0); setOnClickListener { click() }
+        }
+        buttons.addView(button("关闭", "关闭完整回复") { preview?.dismiss() }, LayoutParams(-2, dp(40)))
+        buttons.addView(button("填入这句", "填入完整回复", true) { insert(text, session, ic) }, LayoutParams(-2, dp(40)))
+        panel.addView(buttons, LayoutParams(-1, -2))
+        panel.measure(MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(0, MeasureSpec.UNSPECIFIED))
+        val window = PopupWindow(panel, width, -2, false).apply {
+            // getLocationOnScreen uses display coordinates. Without this flag,
+            // PopupWindow adds the status-bar inset again on the physical IME window.
+            setIsLaidOutInScreen(true)
+            inputMethodMode = PopupWindow.INPUT_METHOD_NOT_NEEDED
+            softInputMode = WindowManager.LayoutParams.SOFT_INPUT_STATE_UNCHANGED or WindowManager.LayoutParams.SOFT_INPUT_ADJUST_NOTHING
+            isOutsideTouchable = true; elevation = dp(8).toFloat(); setBackgroundDrawable(android.graphics.drawable.ColorDrawable(android.graphics.Color.TRANSPARENT))
+            setOnDismissListener { preview = null }
+        }
+        preview = window
+        window.showAtLocation(this, Gravity.TOP or Gravity.START, (resources.displayMetrics.widthPixels - width) / 2, (location[1] - panel.measuredHeight - dp(8)).coerceAtLeast(top + dp(4)))
+    }
+    private fun openAccount() {
+        dismiss(); service.requestHideSelf(0)
+        runCatching { context.startActivity(Intent().setClassName("org.agentos.assistant", "org.agentos.assistant.PanelActivity")
+            .putExtra("page", "account").addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) }
+    }
+    private fun cancelRound() {
+        generation++; task?.cancel(); task = null; preview?.dismiss(); preview = null
+        val id = token; token = ""
+        if (id.isNotEmpty()) service.lifecycleScope.launch(Dispatchers.IO) {
+            runCatching { call(context, JSONObject().put("action", "cancel").put("id", id)) }
+        }
+    }
+    fun finishInput() { activeField = ""; activeConnection = null; activeInfo = null; activeFlags = null; dismiss() }
+    fun dismiss() { cancelRound(); candidates = emptyList(); visibility = GONE; content.removeAllViews(); onVisibilityChanged(false) }
+    override fun onDetachedFromWindow() { finishInput(); super.onDetachedFromWindow() }
+    companion object {
+        fun call(context: Context, request: JSONObject): JSONObject {
+            val raw = context.contentResolver.call(Uri.parse("content://org.agentos.assistant.ime-replies"), "reply", request.toString(), null)?.getString("result") ?: error("回复服务尚未连接")
+            val result = JSONObject(raw); check(result.optBoolean("ok")) { result.optString("message", "回复暂时不可用") }
+            return result.getJSONObject("result")
+        }
+    }
+}
