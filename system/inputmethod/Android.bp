// Preserve the independently signed IME; it must not gain the platform UID/signature.
android_app_import {
    name: "TakuInputMethod",
    apk: "prebuilt/TakuInputMethod.apk",
    presigned: true,
    preprocessed: true,
    required: [
        "taku-ime-libFcitx5Config",
        "taku-ime-libFcitx5Core",
        "taku-ime-libFcitx5Utils",
        "taku-ime-libIMECore",
        "taku-ime-libIMEPinyin",
        "taku-ime-libIMETable",
        "taku-ime-libandroidfrontend",
        "taku-ime-libandroidkeyboard",
        "taku-ime-libandroidnotification",
        "taku-ime-libcxx_shared",
        "taku-ime-libchttrans",
        "taku-ime-libclipboard",
        "taku-ime-libfullwidth",
        "taku-ime-libimselector",
        "taku-ime-libluaaddonloader",
        "taku-ime-libnative-lib",
        "taku-ime-libpinyin",
        "taku-ime-libpinyinhelper",
        "taku-ime-libpunctuation",
        "taku-ime-libquickphrase",
        "taku-ime-libspell",
        "taku-ime-libtable",
        "taku-ime-libunicode",
        "taku-ime-native-dir-link",
        "taku-ime-scel-link",
    ],
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    system_ext_specific: true,
}
