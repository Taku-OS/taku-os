    srcs: ["prebuilt/arm64-v8a/libnative-lib.so"],
    shared_libs: ["libc", "libdl", "liblog", "taku-ime-libFcitx5Config", "taku-ime-libFcitx5Core", "taku-ime-libFcitx5Utils", "taku-ime-libIMECore", "taku-ime-libIMEPinyin", "taku-ime-libIMETable", "taku-ime-libcxx_shared"],
