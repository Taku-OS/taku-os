// Private Fcitx native files. All bytes/ELF metadata are locked in rom-input-lock.json.
cc_defaults {
    name: "taku-ime-native-defaults",
    system_ext_specific: true,
    compile_multilib: "64",
    relative_install_path: "taku-inputmethod",
    stl: "none",
    strip: { none: true },
    check_elf_files: true,
    system_shared_libs: ["libc", "libm", "libdl"],
}

cc_prebuilt_library_shared {
    name: "taku-ime-libFcitx5Config",
    defaults: ["taku-ime-native-defaults"],
    stem: "libFcitx5Config",
    srcs: ["prebuilt/arm64-v8a/libFcitx5Config.so"],
    shared_libs: ["libc", "libdl", "taku-ime-libFcitx5Utils", "taku-ime-libcxx_shared"],
}

cc_prebuilt_library_shared {
    name: "taku-ime-libFcitx5Core",
    defaults: ["taku-ime-native-defaults"],
    stem: "libFcitx5Core",
    srcs: ["prebuilt/arm64-v8a/libFcitx5Core.so"],
    shared_libs: ["libc", "libdl", "taku-ime-libFcitx5Config", "taku-ime-libFcitx5Utils", "taku-ime-libcxx_shared"],
}

cc_prebuilt_library_shared {
    name: "taku-ime-libFcitx5Utils",
    defaults: ["taku-ime-native-defaults"],
    stem: "libFcitx5Utils",
    srcs: ["prebuilt/arm64-v8a/libFcitx5Utils.so"],
    shared_libs: ["libc", "libdl", "taku-ime-libcxx_shared"],
}

