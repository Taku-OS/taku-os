install_symlink {
    name: "taku-ime-native-dir-link",
    system_ext_specific: true,
    installed_location: "app/TakuInputMethod/lib/arm64",
    symlink_target: "/system_ext/lib64/taku-inputmethod",
}

install_symlink {
    name: "taku-ime-scel-link",
    system_ext_specific: true,
    installed_location: "lib64/taku-inputmethod/libscel2org5.so",
    symlink_target: "/system_ext/bin/taku-inputmethod/libscel2org5.so",
    required: ["taku-ime-libscel2org5"],
}
