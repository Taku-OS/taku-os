android_app {
    name: "TakuNotebook",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java", ":taku-notebook-ai-sources"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    sdk_version: "current",
    certificate: "platform",
    system_ext_specific: true,
    required: ["taku-notebook-default-permissions"],
}

prebuilt_etc {
    name: "taku-notebook-default-permissions",
    src: "default-permissions.xml",
    filename: "taku-notebook.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}
