+package com.swmansion.enriched.markdown.segments
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.drawable.GradientDrawable
+import android.widget.HorizontalScrollView
+import kotlin.math.min
+
+/** Persistent, non-interactive hints: disappear only when that edge is reached. */
+internal class HorizontalOverflowIndicator(
+  context: Context,
+  backgroundColor: Int,
+  foregroundColor: Int,
+) {
+  private val density = context.resources.displayMetrics.density
+  private val fadeWidth = 28f * density
+  private val transparent = backgroundColor and 0x00FFFFFF
+  private val rightFade = GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT, intArrayOf(transparent, backgroundColor))
+  private val leftFade = GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT, intArrayOf(backgroundColor, transparent))
+  private val arrow = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+    color = (foregroundColor and 0x00FFFFFF) or (0x99 shl 24)
+    strokeWidth = 1.5f * density
+    strokeCap = Paint.Cap.ROUND
+  }
+
+  // Called from the parent after children: coordinates never move with scrollX.
+  fun draw(canvas: Canvas, scrollView: HorizontalScrollView) {
+    val left = scrollView.left.toFloat()
+    val right = scrollView.right.toFloat()
+    val top = scrollView.top.toFloat()
+    val bottom = scrollView.bottom.toFloat()
+    val fade = min(fadeWidth, (right - left) / 3f)
+    val y = top + min(20f * density, (bottom - top) / 2f)
+    val arm = 3f * density
+    if (scrollView.canScrollHorizontally(1)) {
+      rightFade.setBounds((right - fade).toInt(), top.toInt(), right.toInt(), bottom.toInt())
+      rightFade.draw(canvas)
+      val x = right - 7f * density
+      canvas.drawLine(x - arm, y - arm, x, y, arrow)
+      canvas.drawLine(x, y, x - arm, y + arm, arrow)
+    }
+    if (scrollView.canScrollHorizontally(-1)) {
+      leftFade.setBounds(left.toInt(), top.toInt(), (left + fade).toInt(), bottom.toInt())
+      leftFade.draw(canvas)
+      val x = left + 7f * density
+      canvas.drawLine(x + arm, y - arm, x, y, arrow)
+      canvas.drawLine(x, y, x + arm, y + arm, arrow)
+    }
+  }
+}
