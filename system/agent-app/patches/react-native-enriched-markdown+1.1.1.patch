+  override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+    super.onSizeChanged(w, h, oldw, oldh)
+    // The viewport geometry changes with size, not with streamed cell content
+    // or horizontal scroll. Reuse it for every subsequent display-list draw.
+    viewportRect.set(0f, 0f, w.toFloat(), h.toFloat())
+    viewportPath.reset()
+    viewportPath.addRoundRect(viewportRect, tableStyle.borderRadius, tableStyle.borderRadius, Path.Direction.CW)
+    val halfStroke = tableStyle.borderWidth / 2f
+    viewportRect.inset(halfStroke, halfStroke)
+  }
+
+  override fun dispatchDraw(canvas: Canvas) {
+    // A wide grid's own right border scrolls offscreen; keep a second outline
+    // anchored to the viewport, including while rows are still streaming.
+    val overflow = scrollView.canScrollHorizontally(-1) || scrollView.canScrollHorizontally(1)
+    if (!overflow) {
+      super.dispatchDraw(canvas)
+      return
+    }
+    val saved = canvas.save()
