<?xml version="1.0" encoding="utf-8"?>
<!-- Primary (orange) button. Pressed: Brand/400. Focus: 2dp ink ring with a gap, like the web focus outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape android:shape="rectangle"><solid android:color="@color/taku_surface_disabled"/><corners android:radius="@dimen/taku_button_radius"/></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/taku_action_primary_pressed"/><corners android:radius="@dimen/taku_button_radius"/></shape></item>
    <item android:state_focused="true"><layer-list>
            <item><shape android:shape="rectangle"><stroke android:width="2dp" android:color="@color/taku_focus"/><corners android:radius="@dimen/taku_button_radius"/></shape></item>
            <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp"><shape android:shape="rectangle"><solid android:color="@color/taku_action_primary"/><corners android:radius="@dimen/taku_button_radius"/></shape></item>
        </layer-list></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/taku_action_primary"/><corners android:radius="@dimen/taku_button_radius"/></shape></item>
</selector>
