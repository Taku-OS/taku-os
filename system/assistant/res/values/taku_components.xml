<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written component styles. Values come from taku_colors / taku_dimens / taku_type. -->
<resources>
    <style name="Widget.Taku.Button" parent="">
        <item name="android:minHeight">@dimen/taku_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/taku_mobile_button_pad_x</item>
        <item name="android:paddingEnd">@dimen/taku_mobile_button_pad_x</item>
        <item name="android:paddingTop">@dimen/taku_button_pad_y</item>
        <item name="android:paddingBottom">@dimen/taku_button_pad_y</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Taku.Body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/taku_button_neutral_bg</item>
        <item name="android:textColor">@color/taku_button_text_ink</item>
    </style>
    <!-- Orange with ink text (4.6:1 even when pressed). -->
    <style name="Widget.Taku.Button.Primary">
        <item name="android:background">@drawable/taku_button_primary_bg</item>
        <item name="android:textColor">@color/taku_button_text_ink</item>
    </style>
    <style name="Widget.Taku.Button.Secondary">
        <item name="android:background">@drawable/taku_button_secondary_bg</item>
        <item name="android:textColor">@color/taku_button_text_inverse</item>
    </style>
    <!-- Destructive action (Cancel booking): red, white text, same size as the keep option. -->
    <style name="Widget.Taku.Button.Danger">
        <item name="android:background">@drawable/taku_button_danger_bg</item>
        <item name="android:textColor">@color/taku_button_text_inverse</item>
    </style>
    <!-- Card: white, 16dp radius, native approximation of the web soft-shadow target, not a CSS conversion. Verify on device. -->
    <style name="Widget.Taku.Card" parent="">
        <item name="android:background">@drawable/taku_card_bg</item>
        <item name="android:padding">@dimen/taku_space_16</item>
        <item name="android:elevation">@dimen/taku_card_elevation</item>
        <item name="android:outlineAmbientShadowColor">@color/taku_card_shadow</item>
        <item name="android:outlineSpotShadowColor">@color/taku_card_shadow</item>
    </style>
    <!-- Icon-only button: 48dp touch target, 20dp glyph. Icons are black drawings tinted here. -->
    <style name="Widget.Taku.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/taku_icon_button_bg</item>
        <item name="android:tint">@color/taku_text_primary</item>
    </style>
    <!-- Conversation avatar: 40dp plate with one character (first character of the conversation name).
         Color: one of the six Lift colors per conversation; set android:backgroundTint (see android.md). Default Lavender. -->
    <style name="Widget.Taku.Avatar" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/taku_avatar_bg</item>
        <item name="android:textAppearance">@style/TextAppearance.Taku.Label</item>
        <item name="android:maxLines">1</item>
    </style>
    <!-- Status label with a colored dot. Paused, queued and not started use the base style. -->
    <style name="Widget.Taku.Status" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Taku.MetaMedium</item>
        <item name="android:textColor">@color/taku_text_secondary</item>
        <item name="android:drawableStart">@drawable/taku_status_dot</item>
        <item name="android:drawablePadding">@dimen/taku_space_6</item>
        <item name="android:drawableTint">@color/taku_status_waiting</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Widget.Taku.Status.Working">
        <item name="android:drawableTint">@color/taku_status_attention</item>
    </style>
    <style name="Widget.Taku.Status.NeedsYou">
        <item name="android:drawableTint">@color/taku_status_attention</item>
        <item name="android:textColor">@color/taku_text_primary</item>
    </style>
    <style name="Widget.Taku.Status.Done">
        <item name="android:drawableTint">@color/taku_status_success</item>
    </style>
    <style name="Widget.Taku.Status.Failed">
        <item name="android:drawableTint">@color/taku_status_error</item>
        <item name="android:textColor">@color/taku_text_primary</item>
    </style>
</resources>
