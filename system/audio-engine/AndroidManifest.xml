<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.agentos.audio" android:versionCode="2" android:versionName="0.2.0">
 <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36"/>
 <permission android:name="org.agentos.audio.USE_AUDIO" android:protectionLevel="signature"/>
 <uses-permission android:name="android.permission.RECORD_AUDIO"/>
 <uses-permission android:name="android.permission.CALL_AUDIO_INTERCEPTION"/>
 <uses-permission android:name="android.permission.BYPASS_CONCURRENT_RECORD_AUDIO_RESTRICTION"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
 <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING"/>
 <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT"/>
 <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
 <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
 <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
 <application android:label="@string/app_name" android:icon="@drawable/taku_brand_mark" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:extractNativeLibs="false">
  <activity android:name=".AudioHomeActivity" android:taskAffinity="org.agentos.audio.home" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:exported="true">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
    <category android:name="android.intent.category.LAUNCHER"/>
   </intent-filter>
  </activity>
  <!-- Deliberate device-local open access per AGENTS.md: includes credential replacement
       and backend/policy writes. No caller allowlist. See docs/agent-open-access.md. -->
  <provider android:name=".AudioOpenAccessProvider" android:authorities="org.agentos.audio.open-access" android:exported="true"/>
  <activity android:name=".AudioStatusActivity" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:exported="true" android:permission="org.agentos.audio.USE_AUDIO"/>
  <activity android:name=".AudioSettingsActivity" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:exported="true"/>
  <activity android:name=".DictationSettingsActivity" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:exported="true"/>
  <activity android:name=".AudioHostActivity" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:exported="true"/>
  <activity android:name=".MediaTranslationActivity" android:launchMode="singleTask" android:exported="true" android:permission="org.agentos.audio.USE_AUDIO"/>
  <receiver android:name=".AudioBridgeReceiver" android:exported="true" android:permission="android.permission.DUMP"/>
  <service android:name=".AudioEngineService" android:foregroundServiceType="mediaPlayback|microphone" android:exported="true"/>
  <service android:name=".TranslationOverlayService" android:foregroundServiceType="specialUse" android:exported="true" android:permission="org.agentos.audio.USE_AUDIO">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="persistent translation floating window entry"/>
  </service>
 </application>
</manifest>
