android_app {
    name: "TakuClock",
    manifest: "clock/AndroidManifest.xml",
    srcs: ["clock/src/**/*.java", "shared/**/*.java"],
    resource_dirs: ["shared-res", "clock/res"],
    certificate: "platform",
    sdk_version: "system_current",
    system_ext_specific: true,
}
android_app {
    name: "TakuWeather",
    manifest: "weather/AndroidManifest.xml",
    srcs: ["weather/src/**/*.java", "shared/**/*.java"],
    resource_dirs: ["shared-res", "weather/res"],
    certificate: "platform",
    sdk_version: "system_current",
    system_ext_specific: true,
}
