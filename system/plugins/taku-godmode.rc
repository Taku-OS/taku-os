service taku_godmode /system_ext/bin/taku-godmode-host
    class late_start
    user root
    group root system inet
    seclabel u:r:su:s0
    disabled
    restart_period 10

# Installs the large REA runtime pack from its pinned release and registers the
# bundled provider. Boot stays usable while the download runs; failures are
# retried on the next boot or by `taku-rea-provision --force`.
service taku_rea_provision /system_ext/bin/taku-rea-provision
    class late_start
    user root
    group root system inet
    seclabel u:r:su:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start taku_godmode
    start taku_rea_provision
