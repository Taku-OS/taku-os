+    private void updateDedicatedDisplayAudioPolicy() {
+        final ArraySet<Integer> dedicatedUids = new ArraySet<>();
+        forAllDisplays(display -> {
+            if (!isDedicatedAudioDisplay(display)) {
+                return;
+            }
+            display.forAllActivities(activity -> {
+                if (!activity.finishing && UserHandle.isApp(activity.getUid())) {
+                    dedicatedUids.add(activity.getUid());
+                }
+            });
+        });
+
+        if (!dedicatedUids.isEmpty()) {
+            // Playback registrations carry a UID, not a display. Preserve audio when
+            // that UID also has a visible activity on a regular display.
+            forAllDisplays(display -> {
+                if (!isDedicatedAudioDisplay(display) && !display.isRemovedOrInvalid()) {
+                    display.forAllActivities(activity -> {
+                        if (!activity.finishing && activity.isVisibleRequested()) {
+                            dedicatedUids.remove(activity.getUid());
+                        }
+                    });
+                }
+            });
+        }
+        DedicatedDisplayAudioPolicy.publish(dedicatedUids);
+    }
+
+    private static boolean isDedicatedAudioDisplay(DisplayContent display) {
+        if (display.isRemoving() || display.isRemovedOrInvalid()) {
+            return false;
+        }
+        final DisplayInfo info = display.getDisplayInfo();
+        final int requiredFlags = Display.FLAG_TRUSTED | Display.FLAG_OWN_DISPLAY_GROUP;
+        return info.type == Display.TYPE_VIRTUAL && (info.flags & requiredFlags) == requiredFlags
+                && DedicatedDisplayAudioPolicy.isDedicatedHost(info.ownerUid, info.name);
+    }
