+    @GuardedBy("mPlayerLock")
+    private void updateDedicatedDisplayMute(AudioPlaybackConfiguration player) {
+        final int piid = player.getPlayerInterfaceId();
+        final boolean mute = DedicatedDisplayAudioPolicy.shouldMute(player.getClientUid());
+        if (mute == mDedicatedDisplayMutedPlayers.contains(piid)) {
+            return;
+        }
+        try {
+            player.getPlayerProxy().applyVolumeShaper(DEDICATED_DISPLAY_MUTE,
+                    mute ? PLAY_SKIP_RAMP : VolumeShaper.Operation.REVERSE);
+            if (mute) {
+                mDedicatedDisplayMutedPlayers.add(piid);
+            } else {
+                mDedicatedDisplayMutedPlayers.remove(piid);
+            }
+        } catch (Exception e) {
+            if (!mute && !mEventHandler.hasCallbacks(mRefreshDedicatedDisplayMute)) {
+                mEventHandler.postDelayed(mRefreshDedicatedDisplayMute, 1000);
+            }
+            Log.w(TAG, "Could not update dedicated display mute for player " + piid, e);
+        }
+    }
