+package com.android.server.audio;
+
+import android.os.Process;
+
+import java.util.Set;
+
+/** Publishes window-manager ownership without making audio calls under the window lock. */
+public final class DedicatedDisplayAudioPolicy {
+    private static final String DISPLAY_NAME = "Taku-Independent-Screen";
+    private static volatile Set<Integer> sMutedUids = Set.of();
+    private static Runnable sOnChange;
+
+    private DedicatedDisplayAudioPolicy() {}
+
+    public static boolean isDedicatedHost(int ownerUid, String name) {
+        return (ownerUid == Process.ROOT_UID || ownerUid == Process.SYSTEM_UID
+                || ownerUid == Process.SHELL_UID)
+                && name != null
+                && (DISPLAY_NAME.equals(name) || name.startsWith(DISPLAY_NAME + "-"));
+    }
+
+    static boolean shouldMute(int uid) {
+        return sMutedUids.contains(uid);
+    }
+
+    static synchronized void setOnChange(Runnable onChange) {
+        sOnChange = onChange;
+    }
+
+    /** The listener only queues work on the playback monitor's handler. */
+    public static synchronized void publish(Set<Integer> mutedUids) {
+        if (!sMutedUids.equals(mutedUids)) {
+            sMutedUids = Set.copyOf(mutedUids);
+            if (sOnChange != null) {
+                sOnChange.run();
+            }
+        }
+    }
+}
