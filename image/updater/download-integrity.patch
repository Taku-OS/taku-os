+/*
+ * SPDX-FileCopyrightText: 2026 Taku OS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.updater.download;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Byte-level checks shared by whole-package and payload-range downloads. */
+public final class DownloadIntegrity {
+    private static final Pattern CONTENT_RANGE =
+            Pattern.compile("bytes ([0-9]+)-([0-9]+)/([0-9]+)");
+    private static final Pattern SHA256 = Pattern.compile("[0-9a-fA-F]{64}");
+
+    private DownloadIntegrity() {}
+
+    public static final class ContentRange {
+        public final long start;
+        public final long end;
+        public final long total;
+
+        private ContentRange(long start, long end, long total) {
+            this.start = start;
+            this.end = end;
+            this.total = total;
+        }
+    }
+
+    public static ContentRange parseContentRange(String header) throws IOException {
+        Matcher match = CONTENT_RANGE.matcher(header == null ? "" : header);
+        if (!match.matches()) throw new IOException("Invalid Content-Range");
+        try {
+            long start = Long.parseLong(match.group(1));
+            long end = Long.parseLong(match.group(2));
+            long total = Long.parseLong(match.group(3));
+            if (start > end || total <= 0 || end >= total) {
+                throw new IOException("Invalid Content-Range boundaries");
+            }
+            return new ContentRange(start, end, total);
+        } catch (NumberFormatException e) {
+            throw new IOException("Content-Range overflow", e);
+        }
+    }
+
+    public static boolean hasResumeData(File destination) {
+        return destination.isFile() && destination.length() > 0;
+    }
+
+    public static long validateResponse(boolean resumed, long offset, int status,
+            String contentRange, long contentLength) throws IOException {
+        if (offset < 0 || contentLength < -1) throw new IOException("Invalid response length");
+        if (!resumed) {
+            if (offset != 0 || status != 200 || contentRange != null) {
+                throw new IOException("Expected a complete HTTP 200 response");
+            }
+            if (contentLength == 0) throw new IOException("Empty update response");
+            return contentLength;
+        }
+        if (status != 206 || offset <= 0) throw new IOException("Expected resumed HTTP 206");
+        ContentRange range = parseContentRange(contentRange);
+        if (range.start != offset || range.end != range.total - 1) {
+            throw new IOException("Resumed Content-Range differs from requested remainder");
+        }
+        long remaining = range.total - range.start;
+        if (contentLength >= 0 && contentLength != remaining) {
+            throw new IOException("Range Content-Length differs");
+        }
+        return range.total;
+    }
+
+    public static void verifyLength(long actual, long expected) throws IOException {
+        if (actual < 0 || (expected >= 0 && actual != expected)) {
+            throw new IOException("Truncated or oversized update response");
+        }
+    }
+
+    public static void verifyFile(File file, String expectedSha256, long expectedSize)
+            throws IOException {
+        if (expectedSize <= 0 || expectedSha256 == null
+                || !SHA256.matcher(expectedSha256).matches()) {
+            throw new IOException("Missing accepted update size or SHA-256");
+        }
+        verifyLength(file.length(), expectedSize);
+        try {
+            MessageDigest sha = MessageDigest.getInstance("SHA-256");
+            long size = 0;
+            try (FileInputStream input = new FileInputStream(file)) {
+                byte[] buffer = new byte[64 * 1024];
+                int count;
+                while ((count = input.read(buffer)) != -1) {
+                    sha.update(buffer, 0, count);
+                    size += count;
+                }
+            }
+            verifyLength(size, expectedSize);
+            StringBuilder hex = new StringBuilder(64);
+            for (byte b : sha.digest()) {
+                hex.append(Character.forDigit((b >>> 4) & 15, 16));
+                hex.append(Character.forDigit(b & 15, 16));
+            }
+            if (!hex.toString().equalsIgnoreCase(expectedSha256)) {
+                throw new IOException("Downloaded update SHA-256 differs from accepted feed");
+            }
+        } catch (NoSuchAlgorithmException e) {
+            throw new IOException("SHA-256 unavailable", e);
+        }
+    }
+}
