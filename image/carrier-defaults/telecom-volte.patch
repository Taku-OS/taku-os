+package com.android.phone;
+
+import com.android.internal.annotations.VisibleForTesting;
+
+/** Product defaults for the first, narrowly scoped China Telecom tokay adaptation. */
+@VisibleForTesting
+final class TakuCarrierDefaults {
+    private TakuCarrierDefaults() {}
+
+    /**
+     * Uses the home SIM identity, never the currently visited radio network.
+     * This only lifts VoLTE's availability gate. Entitlement, IMS registration,
+     * roaming policy and the user's enhanced-4G preference remain independent.
+     * Specific/unknown MVNO identities and data-only profiles are left untouched.
+     */
+    @VisibleForTesting
+    static boolean shouldEnableVolte(String device, boolean simLoaded, String simOperator,
+            int carrierId, int specificCarrierId, boolean voiceCapable,
+            boolean carrierProvidesVolte, boolean platformConfigLoaded) {
+        return platformConfigLoaded && "tokay".equals(device) && simLoaded && voiceCapable && !carrierProvidesVolte
+                && carrierId == 2237 && specificCarrierId == 2237
+                && ("46003".equals(simOperator) || "46011".equals(simOperator));
+    }
+}
