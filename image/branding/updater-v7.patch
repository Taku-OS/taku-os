new file mode 100644
--- /dev/null
+++ b/app/src/main/java/org/lineageos/updater/TakuBrand.kt
@@ -0,0 +1,22 @@
+// Generated from image/product-branding.json.
+package org.lineageos.updater
+
+import android.os.SystemProperties
+
+object TakuBrand {
+    const val NAME = "TakuOS"
+    const val VERSION = "1.2.0"
+    const val DISPLAY_VERSION = "TakuOS1.2.0"
+    private val versionPattern = Regex("(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)")
+    private val legacyPattern = Regex("[0-9]+\\.[0-9]+")
+    private fun validVersion(value: String?) = value?.takeIf {
+        versionPattern.matches(it) || legacyPattern.matches(it)
+    }
+    fun targetVersion(value: String?): String? =
+        value?.takeIf { it.startsWith(NAME) }?.removePrefix(NAME)?.let(::validVersion)
+    val currentVersion: String
+        get() = validVersion(SystemProperties.get("ro.taku.product.version", ""))
+            ?: targetVersion(SystemProperties.get("ro.taku.display.version", "")) ?: VERSION
+    fun targetDisplayName(value: String?) = targetVersion(value)?.let { "$NAME $it" } ?: NAME
+    fun buildLabel(value: String?, date: String) = "${targetDisplayName(value)} - $date"
+}
