+    private var pendingMenuPhoto: Uri? = null
+
+    private fun requestTakuMenuReview(photo: Uri) {
+        if (Build.VERSION.SDK_INT < 36 || keyguardManager.isKeyguardLocked) return
+        pendingMenuPhoto = photo
+        val reply = object : ResultReceiver(Handler(Looper.getMainLooper())) {
+            override fun onReceiveResult(resultCode: Int, resultData: Bundle?) {
+                val review = resultData?.getParcelable("review", PendingIntent::class.java)
+                if (pendingMenuPhoto != photo) return
+                pendingMenuPhoto = null
+                if (resultCode != 1 || review == null || !hasWindowFocus() ||
+                    lifecycle.currentState != Lifecycle.State.RESUMED || keyguardManager.isKeyguardLocked
+                ) return
+                val options = ActivityOptions.makeBasic().setPendingIntentBackgroundActivityStartMode(
+                    ActivityOptions.MODE_BACKGROUND_ACTIVITY_START_ALLOW_IF_VISIBLE
+                )
+                try {
+                    review.send(this@CameraActivity, 0, null, null, null, null, options.toBundle())
+                } catch (_: PendingIntent.CanceledException) {
+                }
+            }
+        }
+        // Only the framework receiver type is available to the remote class loader.
+        val parcel = Parcel.obtain()
+        val remoteReply = try {
+            reply.writeToParcel(parcel, 0)
+            parcel.setDataPosition(0)
+            ResultReceiver.CREATOR.createFromParcel(parcel)
+        } finally {
+            parcel.recycle()
+        }
+        lifecycleScope.launch(Dispatchers.IO) {
+            val endpoint = Uri.parse("content://org.agentos.agent.menu-capture")
+            try {
+                contentResolver.openFileDescriptor(photo, "r")?.use { descriptor ->
+                    contentResolver.call(endpoint, "scan", null, Bundle().apply {
+                        putParcelable("photo", descriptor)
+                        putParcelable("result", remoteReply)
+                    })
+                }
+            } catch (error: Exception) {
+                Log.d("TakuMenuCapture", "Menu review unavailable", error)
+            }
+        }
+    }
