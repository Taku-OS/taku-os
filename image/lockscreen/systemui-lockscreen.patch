+    private val cache = HashMap<String, Pair<Long, App>>()
+
+    fun get(context: Context, sbn: StatusBarNotification): App {
+        val info = sbn.notification.extras.getParcelable(EXTRA_APPLICATION_INFO, ApplicationInfo::class.java)
