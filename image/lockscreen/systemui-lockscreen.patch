+    /** Blurred wallpaper. */
+    private val blurred = RenderNode("TakuLockscreenBlur")
+    /** Blurred wallpaper plus the gradient: the whole page. */
+    private val page = RenderNode("TakuLockscreenPage")
+    /** The bottom slice of [page], blurred again and refracted. */
