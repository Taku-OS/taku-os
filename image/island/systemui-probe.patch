+                // Figma's 16 dp dot loader: animated while working, its resting pose otherwise.
+                val pose = if (ValueAnimator.areAnimatorsEnabled()) DotMatrixLoader.thinking(phase * DotMatrixLoader.CYCLE_MS.toDouble(), loaderPose)
