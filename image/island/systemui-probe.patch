+        attached = true
+        covering(cover)
+        // Native content is complete before addView: no template/remote-surface transition.
+        if (nativeProgress) {
+            updateProgressBackdrop()
+            wm.addCrossWindowBlurEnabledListener(windowContext.mainExecutor, blurListener)
