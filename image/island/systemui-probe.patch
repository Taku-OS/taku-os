+    /** 16 dp glyph area centred on ([cx], [cy]): Figma's 3×3 loader, a picture or a progress ring. */
+    private fun drawDisc(canvas: Canvas, slot: JSONObject?, cx: Float, cy: Float, loaded: Map<String, Drawable>) {
