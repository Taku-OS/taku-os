+            case BEGIN_ARRAY:
+                JSONArray array = new JSONArray();
+                reader.beginArray();
+                while (reader.hasNext()) array.put(readJson(reader));
+                reader.endArray();
+                return array;
+            case STRING: return reader.nextString();
+            case BOOLEAN: return reader.nextBoolean();
+            case NULL:
