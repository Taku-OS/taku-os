+                .put("compiledAndDeviceVerified", false)
+                .put("operations", JSONArray(listOf("list", "get", "select", "next", "tap", "expand", "collapse", "dismiss", "hide", "action", "open", "settings", "setEnabled", "setAllowed", "setLockScreen")))
