diff --git a/quickstep/src/com/android/quickstep/TakuRecentsBackdrop.java b/quickstep/src/com/android/quickstep/TakuRecentsBackdrop.java
new file mode 100644
index 0000000..54b7662
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/TakuRecentsBackdrop.java
@@ -0,0 +1,58 @@
+/* Copyright 2026 Taku OS. Licensed under the Apache License, Version 2.0. */
+package com.android.quickstep;
+
+import android.content.Context;
+import android.content.res.Configuration;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.RenderEffect;
+import android.graphics.Shader;
+import android.util.Log;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import com.android.launcher3.util.Executors;
+import java.io.InputStream;
+
+/** Bundled HOME wallpaper only; decoding never blocks the overview UI thread. */
+public final class TakuRecentsBackdrop {
+    private TakuRecentsBackdrop() { }
+    public static void install(Context context, ViewGroup root) {
+        if (context.getResources().getConfiguration().smallestScreenWidthDp >= 600) return;
+        ImageView backdrop = new ImageView(context) {
+            @Override protected void onConfigurationChanged(Configuration configuration) {
+                super.onConfigurationChanged(configuration);
+                setVisibility(configuration.orientation == Configuration.ORIENTATION_PORTRAIT ? View.VISIBLE : View.GONE);
+            }
+        };
+        backdrop.setVisibility(context.getResources().getConfiguration().orientation == Configuration.ORIENTATION_PORTRAIT ? View.VISIBLE : View.GONE);
+        backdrop.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        backdrop.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        backdrop.setFocusable(false);
+        backdrop.setClickable(false);
+        float radius = 24f * context.getResources().getDisplayMetrics().density;
+        backdrop.setRenderEffect(RenderEffect.createBlurEffect(radius, radius, Shader.TileMode.CLAMP));
+        com.android.launcher3.InsettableFrameLayout.LayoutParams params =
+                new com.android.launcher3.InsettableFrameLayout.LayoutParams(-1, -1);
+        params.ignoreInsets = true;
+        root.addView(backdrop, 0, params);
+        Executors.UI_HELPER_EXECUTOR.execute(() -> {
+            try {
+                Context home = context.createPackageContext("org.agentos.agent", 0);
+                Bitmap bitmap;
+                BitmapFactory.Options options = new BitmapFactory.Options();
+                options.inSampleSize = 4; // Backdrop is heavily blurred; full-size pixels are unnecessary.
+                try (InputStream stream = home.getAssets().open("feed/home/wallpaper.jpg")) {
+                    bitmap = BitmapFactory.decodeStream(stream, null, options);
+                }
+                if (bitmap == null) return;
+                root.post(() -> {
+                    if (root.isAttachedToWindow()) backdrop.setImageBitmap(bitmap);
+                    else bitmap.recycle();
+                });
+            } catch (Exception error) {
+                Log.w("TakuRecentsBackdrop", "Taku wallpaper unavailable; using system backdrop", error);
+            }
+        });
+    }
+}
