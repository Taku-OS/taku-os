new file mode 100644
index 0000000..71838c8
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/TakuRecentsProvider.java
@@ -0,0 +1,133 @@
+/* Copyright 2026 Taku OS. Licensed under the Apache License, Version 2.0. */
+package com.android.quickstep;
+
+import android.app.ActivityManager;
+import android.app.ActivityTaskManager;
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.Process;
+import android.os.UserHandle;
+import com.android.systemui.shared.system.ActivityManagerWrapper;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import java.util.List;
+
+/** Agent access to the same Android task store used by Quickstep; no parallel task database. */
+public final class TakuRecentsProvider extends ContentProvider {
+    @Override public boolean onCreate() { return true; }
+
+    private List<ActivityManager.RecentTaskInfo> tasks() {
+        return ActivityTaskManager.getInstance().getRecentTasks(Integer.MAX_VALUE,
+                ActivityManager.RECENT_IGNORE_UNAVAILABLE, UserHandle.myUserId());
+    }
+
+    private boolean isAppTask(ActivityManager.RecentTaskInfo task) {
+        // Restored recent tasks have no live root yet and are reported as UNDEFINED.
+        // They remain valid app cards in Quickstep and must remain available to Agents.
+        int type = task.getActivityType();
+        return type == android.app.WindowConfiguration.ACTIVITY_TYPE_STANDARD
+                || type == android.app.WindowConfiguration.ACTIVITY_TYPE_UNDEFINED;
+    }
+
+    private boolean showOverview() throws Exception {
+        java.util.concurrent.Callable<Boolean> request = () -> {
+            RecentsActivity activity = RecentsActivity.ACTIVITY_TRACKER.getCreatedContext();
+            if (activity != null && activity.hasBeenResumed() && activity.isRecentsViewVisible()) {
+                return false; // Idempotent show, never toggle a visible overview back to an app.
+            }
+            var connection = com.android.quickstep.sysuiconnection.SysUIConnectionTracker
+                    .get(getContext()).getActiveComponent().getValue();
+            var helper = connection == null ? null : connection.getOverviewCommandHelper().getIfReady();
+            if (helper == null) throw new IllegalStateException("Quickstep is not connected to SystemUI");
+            // Starting RecentsActivity directly skips the app-to-overview animation handshake.
+            if (helper.addCommand(OverviewCommandHelper.CommandType.TOGGLE) == null) {
+                throw new IllegalStateException("Quickstep overview command queue is full");
+            }
+            return true;
+        };
+        if (android.os.Looper.myLooper() == android.os.Looper.getMainLooper()) return request.call();
+        var pending = com.android.launcher3.util.Executors.MAIN_EXECUTOR.submit(request);
+        try {
+            return pending.get(5, java.util.concurrent.TimeUnit.SECONDS);
+        } catch (Exception error) {
+            pending.cancel(false);
+            throw error;
+        }
+    }
+
+    private void enforceTrustedCaller(int uid) {
+        if (uid == Process.ROOT_UID || uid == Process.SYSTEM_UID || uid == Process.SHELL_UID) return;
+        var context = getContext();
+        if (context != null && context.getPackageManager().checkSignatures(uid, Process.SYSTEM_UID)
+                == PackageManager.SIGNATURE_MATCH) return;
+        throw new SecurityException("Recents access requires a trusted system caller");
+    }
+
+    @Override public Bundle call(String method, String arg, Bundle extras) {
+        int callerUid = Binder.getCallingUid();
+        enforceTrustedCaller(callerUid);
+        long token = Binder.clearCallingIdentity();
+        JSONObject result = new JSONObject();
+        try {
+            if ("list".equals(method)) {
+                JSONArray items = new JSONArray();
+                for (ActivityManager.RecentTaskInfo task : tasks()) {
+                    if (!isAppTask(task)) continue;
+                    items.put(new JSONObject().put("taskId", task.taskId)
+                            .put("userId", task.userId)
+                            .put("component", task.baseIntent.getComponent() == null ? JSONObject.NULL
+                                    : task.baseIntent.getComponent().flattenToShortString())
+                            .put("label", task.taskDescription == null || task.taskDescription.getLabel() == null ? JSONObject.NULL
+                                    : task.taskDescription.getLabel()));
+                }
+                result.put("tasks", items).put("source", "ActivityTaskManager")
+                        .put("scope", "current-user-and-visible-profile-app-tasks");
+            } else if ("open".equals(method) || "remove".equals(method)) {
+                int id = Integer.parseInt(arg);
+                if (tasks().stream().noneMatch(t -> t.taskId == id && isAppTask(t))) {
+                    throw new IllegalArgumentException("Unknown visible app task: " + id);
+                }
+                // Same operations used by TaskView launch and RecentsView dismissal.
+                if ("open".equals(method)) {
+                    if (!ActivityManagerWrapper.getInstance().startActivityFromRecents(id, null)) {
+                        throw new IllegalStateException("Task could not be opened: " + id);
+                    }
+                } else {
+                    if (!ActivityTaskManager.getService().removeTask(id)) {
+                        throw new IllegalStateException("Task could not be removed: " + id);
+                    }
+                }
+                result.put("taskId", id);
+            } else if ("show".equals(method)) {
+                result.put("queued", showOverview());
+            } else if ("home".equals(method)) {
+                getContext().startActivity(new Intent(Intent.ACTION_MAIN)
+                        .addCategory(Intent.CATEGORY_HOME).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+            } else {
+                throw new IllegalArgumentException("Methods: list, show, home, open, remove; taskId in arg");
+            }
+            result.put("ok", true);
+        } catch (Exception error) {
+            try { result.put("ok", false).put("error", error.toString()); }
+            catch (org.json.JSONException ignored) { /* String and boolean values are JSON-safe. */ }
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        Bundle response = new Bundle();
+        response.putString("result", result.toString());
+        return response;
+    }
+    @Override public Cursor query(Uri u, String[] p, String s, String[] a, String o) {
+        throw new UnsupportedOperationException("Use content call: list, show, home, open, remove");
+    }
+    @Override public String getType(Uri u) { return "application/json"; }
+    @Override public Uri insert(Uri u, ContentValues v) { throw new UnsupportedOperationException(); }
+    @Override public int update(Uri u, ContentValues v, String s, String[] a) { throw new UnsupportedOperationException(); }
+    @Override public int delete(Uri u, String s, String[] a) { throw new UnsupportedOperationException(); }
+}
