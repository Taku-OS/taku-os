diff --git a/quickstep/src/com/android/quickstep/util/TakuRecentsDepth.java b/quickstep/src/com/android/quickstep/util/TakuRecentsDepth.java
new file mode 100644
index 0000000..fa627d3
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/util/TakuRecentsDepth.java
@@ -0,0 +1,44 @@
+/* Copyright 2026 Taku OS. Licensed under the Apache License, Version 2.0. */
+package com.android.quickstep.util;
+
+/** Shared continuous geometry for task Views and their remote window surfaces. */
+public final class TakuRecentsDepth {
+    private TakuRecentsDepth() {}
+
+    public static float pageSpacing(float width, float density) {
+        return -Math.round(Math.min(width * 0.82f, Math.max(0, width - 48f * density)));
+    }
+
+    public static float distance(float offset, float width, float density) {
+        return Math.abs(offset) / Math.max(1f, width + pageSpacing(width, density));
+    }
+
+    public static float rearDistance(float offset, float width, float density) {
+        return offset < 0 ? distance(offset, width, density) : 0f;
+    }
+
+    public static float spread(float offset, float width, float density, float fullscreenProgress) {
+        if (offset <= 0 || width <= 0) return 0f;
+        float stride = Math.max(1f, width + pageSpacing(width, density));
+        float d = offset / stride;
+        // Right-hand cards fan outward continuously while retaining their fixed layer.
+        // At one logical page, leave most of the middle card exposed. The zero derivative
+        // at the center avoids a kink as a card crosses from the compressed left stack.
+        float expansion = 2f * d * d / (d + 1f);
+        return Math.max(0f, width * 0.82f - stride) * expansion * (1f - fullscreenProgress);
+    }
+
+    public static float amount(float distance) {
+        // Smooth at the focused card and bounded in the far stack; no integer page steps.
+        float squared = distance * distance;
+        return 3f * squared / (2f + squared);
+    }
+
+    public static float scale(float distance, float fullscreenProgress) {
+        return 1f - 0.04f * amount(distance) * (1f - fullscreenProgress);
+    }
+
+    public static float tint(float distance, float fullscreenProgress) {
+        return 0.14f * amount(distance) * (1f - fullscreenProgress);
+    }
+}
