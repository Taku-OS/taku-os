# Same development-only runtime domain as the existing Codex broker.
service taku_magpie /system_ext/bin/magpie serve --web=127.0.0.1:3430
    class late_start
    user root
    group root inet
    seclabel u:r:su:s0
    disabled
    restart_period 10

on post-fs-data
    mkdir /data/local/agentos/magpie 0700 root root

on property:sys.boot_completed=1
    start taku_magpie
