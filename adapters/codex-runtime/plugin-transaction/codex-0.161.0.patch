+#[test]
+fn explicit_lifecycle_commits_enabled_config_with_cache() {
+    let tmp = tempdir().unwrap();
+    let id = PluginId::new("sample-plugin".to_string(), "debug".to_string()).unwrap();
+    let source = AbsolutePathBuf::try_from(tmp.path().join("sample-plugin")).unwrap();
+    write_plugin_with_version(tmp.path(), "sample-plugin", "sample-plugin", Some("1.0.0"));
+    std::fs::write(tmp.path().join("config.toml"), "model = \"example\"\n").unwrap();
+    let store = PluginStore::new(tmp.path().to_path_buf());
+    store.install_explicit(source, id.clone(), None, None).unwrap();
+    let config = std::fs::read_to_string(tmp.path().join("config.toml")).unwrap();
+    assert!(config.contains("enabled = true"));
+    assert_eq!(store.active_plugin_version(&id).as_deref(), Some("1.0.0"));
+    store.uninstall_explicit(&id).unwrap();
+    let config = std::fs::read_to_string(tmp.path().join("config.toml")).unwrap();
+    assert!(config.contains("model = \"example\""));
+    assert!(!config.contains("sample-plugin@debug"));
+    assert!(!store.is_installed(&id));
+}
