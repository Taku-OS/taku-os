+#[test]
+fn rollback_pin_blocks_automatic_cache_writes_until_explicit_uninstall() {
+    let tmp = tempdir().unwrap();
+    let id = PluginId::new("sample-plugin".to_string(), "debug".to_string()).unwrap();
+    let source = AbsolutePathBuf::try_from(tmp.path().join("sample-plugin")).unwrap();
+    let store = PluginStore::new(tmp.path().to_path_buf());
+    write_plugin_with_version(tmp.path(), "sample-plugin", "sample-plugin", Some("1.0.0"));
+    store.install(source.clone(), id.clone()).unwrap();
+    write_plugin_with_version(tmp.path(), "sample-plugin", "sample-plugin", Some("2.0.0"));
+    store.install(source.clone(), id.clone()).unwrap();
+    store.rollback(&id).unwrap();
+    assert_eq!(store.active_plugin_version(&id).as_deref(), Some("1.0.0"));
+    assert!(store.install(source.clone(), id.clone()).is_err());
+    assert!(store.uninstall(&id).is_err());
+    assert!(store.write_remote_plugin_id(&id, "new-remote-id").is_err());
+    assert_eq!(store.active_plugin_version(&id).as_deref(), Some("1.0.0"));
+    store.uninstall_explicit(&id).unwrap();
+    store.install(source, id.clone()).unwrap();
+    assert_eq!(store.active_plugin_version(&id).as_deref(), Some("2.0.0"));
+}
